{
  "description": "Keep non-interactive automated tests out of Codex turns while preserving interactive browser and UI verification.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','pre-tool-use.cjs'))\"",
            "timeout": 5,
            "statusMessage": "Checking for deferred non-interactive tests"
          }
        ]
      },
      {
        "matcher": "open_test_gate$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','pre-tool-use.cjs'))\"",
            "timeout": 5,
            "statusMessage": "Recording Test Gate completion requirement"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','user-prompt-submit.cjs'))\"",
            "timeout": 20,
            "statusMessage": "Checking pending Test Gate validation"
          }
        ]
      }
    ]
  }
}
